# =====================================================================
# Kredensial Service Account Google (dari file JSON "Service Accounts"
# yang diunduh dari Firebase Console -> Project Settings -> Service Accounts)
# ---------------------------------------------------------------------
# project_id  pada file JSON
GOOGLE_PROJECT_ID=madania-enrollment-system
# client_email pada file JSON
GOOGLE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@madania-enrollment-system.iam.gserviceaccount.com
# private_key pada file JSON. Boleh berisi literal \n (seperti di Code.gs)
# atau baris baru asli / base64.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvAIBADANBgkqhkiG9w0BAQEFAASCBKYwggSiAgEAAoIBAQC1qp0J9CV6ByR6...\n-----END PRIVATE KEY-----\n"

# =====================================================================
# Google Sheets (spreadsheet yang sama dengan GAS)
# ---------------------------------------------------------------------
# ID dari URL spreadsheet, mis. https://docs.google.com/spreadsheets/d/<ID_HERE>/edit
# Spreadsheet WAJIB di-share (Editor) ke GOOGLE_CLIENT_EMAIL di atas.
SPREADSHEET_ID=

# =====================================================================
# Notifikasi Email (pengganti MailApp GAS). Gunakan SMTP apa pun,
# mis. Gmail App Password, Zoho, atau layanan SMTP lain.
# Jika SMTP_HOST dikosongkan, email dilewati (app tetap berjalan).
# ---------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_NAME=Sistem Pendaftaran Madania

# Email yang ditampilkan pada Log_Update (pengganti Session.getActiveUser)
ADMIN_EMAIL=admin@madania.sch.id

# =====================================================================
# Nilai awal pengaturan notifikasi (dipakai sampai admin menyimpannya
# lewat UI -> tab Pengaturan; setelah itu tersimpan di Firestore
# koleksi "settings", dokumen "notifications")
# ---------------------------------------------------------------------
NOTIFICATION_EMAILS=admin@madania.sch.id
NOTIFICATION_WHATSAPPS=081234567890
FONNTE_API_KEY=
FONNTE_INSTANCE_ID=

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =================================================================
    // FIRESTORE SECURITY RULES — Madania Enrollment System
    // =================================================================
    //
    // Data utama (pendaftaran, siswaLanjutan, masterSiswa) dibaca/ditulis
    // LANGSUNG dari browser via Firebase Web SDK (lihat Index.html) —
    // jadi harus diizinkan di rules. Service Account tetap bypass rules
    // (admin privileges) untuk akses server-side (Sheets backup, settings, dll).
    //
    // Koleksi `settings` tetap deny (hanya server yang boleh via REST API).
    // Jika ingin lebih aman, ganti `if true` di bawah dengan
    // `if request.auth != null` setelah mengaktifkan Firebase Auth.
    // =================================================================

    // Koleksi yang diakses langsung dari browser
    match /pendaftaran/{docId} {
      allow read, write: if true;
    }
    match /siswaLanjutan/{docId} {
      allow read, write: if true;
    }
    match /masterSiswa/{docId} {
      allow read, write: if true;
    }

    // Settings hanya via server (api/*)
    match /settings/{docId} {
      allow read, write: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
